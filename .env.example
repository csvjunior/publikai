APP_NAME=Publikai
APP_ENV=localAPP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_DISPLAY_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=publikai_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

REGISTRATION_ENABLED=true
REGISTRATION_CODE=

AI_PROVIDER=google
GOOGLE_AI_ENABLED=false
GOOGLE_AI_MODEL=gemini-3.8-flash
GOOGLE_AI_AUTH_KEY=
GOOGLE_AI_TIMEOUT=10
GOOGLE_AI_CONNECT_TIMEOUT=5

GOOGLE_AI_IMAGE_ENABLED=false
GOOGLE_AI_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_AI_IMAGE_TIMEOUT=60
GOOGLE_AI_IMAGE_CONNECT_TIMEOUT=5
GOOGLE_AI_IMAGE_MIME_TYPE=image/jpeg
GOOGLE_AI_IMAGE_ASPECT_RATIO=9:16
GOOGLE_AI_IMAGE_SIZE=1K

GOOGLE_AI_VIDEO_ENABLED=false
GOOGLE_AI_VIDEO_MODEL=gemini-omni-1.1-flash
GOOGLE_AI_VIDEO_TIMEOUT=300
GOOGLE_AI_VIDEO_CONNECT_TIMEOUT=10
GOOGLE_AI_VIDEO_DEFAULT_ASPECT_RATIO=9:16
GOOGLE_AI_VIDEO_DEFAULT_DURATION=8
GOOGLE_AI_VIDEO_MAX_DOWNLOAD_BYTES=104857600
FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=ffmpeg
VIDEO_COMPOSITION_WIDTH=720
VIDEO_COMPOSITION_HEIGHT=1280
VIDEO_COMPOSITION_FPS=30
VIDEO_COMPOSITION_MAX_INPUTS=10
VIDEO_COMPOSITION_MAX_DURATION_SECONDS=120
VIDEO_COMPOSITION_IMAGE_DURATION_MS=3000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
